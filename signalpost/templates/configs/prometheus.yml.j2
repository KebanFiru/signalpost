{% set is_binary = plan.install_mode == "binary" %}
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
{% if is_binary %}
  - {{ output_dir_posix }}/alerts/*.yml
{% else %}
  - /etc/prometheus/alerts/*.yml
{% endif %}

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["{{ 'localhost' if is_binary else 'alertmanager' }}:{{ alertmanager_port }}"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:{{ plan.prometheus_port if is_binary else 9090 }}"]

  - job_name: otel-collector
    static_configs:
      - targets: ["{{ 'localhost' if is_binary else 'otel-collector' }}:8888"]

  - job_name: node-exporter
    static_configs:
      - targets: ["{{ 'localhost' if is_binary else 'node-exporter' }}:9100"]

  - job_name: loki
    static_configs:
      - targets: ["{{ 'localhost' if is_binary else 'loki' }}:3100"]

  - job_name: tempo
    static_configs:
      - targets: ["{{ 'localhost' if is_binary else 'tempo' }}:3200"]

  - job_name: grafana
    static_configs:
      - targets: ["{{ 'localhost' if is_binary else 'grafana' }}:3000"]

  - job_name: alertmanager
    static_configs:
      - targets: ["{{ 'localhost' if is_binary else 'alertmanager' }}:{{ alertmanager_port }}"]
{% if plan.scrape_targets %}

{% for t in plan.scrape_targets %}
  - job_name: "{{ t.job_name }}"
    static_configs:
      - targets: ["{{ t.target }}"]
{% endfor %}
{% endif %}
