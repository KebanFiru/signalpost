{% set is_binary = plan.install_mode == "binary" %}
{% set loki_host = "localhost" if is_binary else "loki" %}
{% set tempo_host = "localhost" if is_binary else "tempo" %}
{% set prometheus_host = "localhost" if is_binary else "prometheus" %}
{% set prometheus_port = plan.prometheus_port if is_binary else 9090 %}
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

processors:
  memory_limiter:
    check_interval: 5s
    limit_mib: {{ plan.memory_limits.otel_collector_mb }}
    spike_limit_mib: {{ (plan.memory_limits.otel_collector_mb / 4) | round(0, 'ceil') | int }}

  batch:
    timeout: 5s
    send_batch_size: 8192

  probabilistic_sampler:
    sampling_percentage: {{ plan.sampling_pct }}

exporters:
  otlp/tempo:
    endpoint: {{ tempo_host }}:4317
    tls:
      insecure: true

  otlphttp/loki:
    endpoint: http://{{ loki_host }}:3100/otlp
    tls:
      insecure: true

  prometheusremotewrite:
    endpoint: http://{{ prometheus_host }}:{{ prometheus_port }}/api/v1/write

  debug:
    verbosity: basic

service:
  pipelines:
    traces:
      receivers: [otlp]
      processors: [memory_limiter, probabilistic_sampler, batch]
      exporters: [otlp/tempo]

    metrics:
      receivers: [otlp]
      processors: [memory_limiter, batch]
      exporters: [prometheusremotewrite]

    logs:
      receivers: [otlp]
      processors: [memory_limiter, batch]
      exporters: [otlphttp/loki]

  telemetry:
    metrics:
      readers:
        - pull:
            exporter:
              prometheus:
                host: 0.0.0.0
                port: 8888
