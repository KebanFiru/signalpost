global:
  resolve_timeout: 5m

route:
  receiver: signalpost-default
  group_by: ["alertname", "severity"]
  group_wait: {{ alertmanager_group_wait }}
  group_interval: {{ alertmanager_group_interval }}
  repeat_interval: {{ alertmanager_repeat_interval }}
  routes:
    - matchers:
        - severity="critical"
      receiver: signalpost-default
      repeat_interval: {{ alertmanager_critical_repeat_interval }}

inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: ["alertname", "instance"]

receivers:
  - name: signalpost-default
{% if plan.notify.kind == "slack" %}
    slack_configs:
      - api_url_file: "{{ alertmanager_webhook_secret_path }}"
        channel: "#alerts"
        send_resolved: true
        title: {% raw %}'{{ if eq .Status "firing" }}:red_circle:{{ else }}:large_green_circle:{{ end }} [{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}'{% endraw %}

        text: {% raw %}>-
          {{ range .Alerts }}*{{ .Annotations.summary }}*

          {{ .Annotations.description }}

          _severity: {{ .Labels.severity }} · instance: {{ .Labels.instance }}_

          {{ end }}{% endraw %}

{% elif plan.notify.kind == "discord" %}
    discord_configs:
      - webhook_url_file: "{{ alertmanager_webhook_secret_path }}"
        send_resolved: true
        title: {% raw %}'[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}'{% endraw %}

        message: {% raw %}>-
          {{ range .Alerts }}**{{ .Annotations.summary }}**

          {{ .Annotations.description }}

          _severity: {{ .Labels.severity }} · instance: {{ .Labels.instance }}_

          {{ end }}{% endraw %}

{% elif plan.notify.kind == "webhook" %}
    webhook_configs:
      - url_file: "{{ alertmanager_webhook_secret_path }}"
        send_resolved: true
{% else %}
{% endif %}
