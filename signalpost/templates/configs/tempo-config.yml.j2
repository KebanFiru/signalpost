{% set is_binary = plan.install_mode == "binary" %}
{% set prometheus_host = "localhost" if is_binary else "prometheus" %}
{% set prometheus_port = plan.prometheus_port if is_binary else 9090 %}
server:
  http_listen_port: 3200

distributor:
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: 0.0.0.0:4317
        http:
          endpoint: 0.0.0.0:4318

storage:
  trace:
    backend: local
    local:
      path: /var/tempo/blocks
    wal:
      path: /var/tempo/wal

backend_worker:
  compaction:
    block_retention: {{ plan.trace_retention_days * 24 }}h

backend_scheduler:
  provider:
    compaction:
      compaction:
        block_retention: {{ plan.trace_retention_days * 24 }}h

metrics_generator:
  registry:
    external_labels:
      source: tempo
  storage:
    path: /var/tempo/generator/wal
    remote_write:
      - url: http://{{ prometheus_host }}:{{ prometheus_port }}/api/v1/write
        send_exemplars: true

overrides:
  defaults:
    metrics_generator:
      processors:
        - service-graphs
        - span-metrics
